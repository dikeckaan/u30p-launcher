<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kaandikec.u30plauncher">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Hucre kimligi (PCI/EARFCN/TAC/CI) icin konum izni sart; ayrica cihazda
         konum servisinin acik olmasi gerekir, aksi halde Android ServiceState'i
         maskeler. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 11+ paket gorunurluk filtresi olmadan yalnizca birkac sistem
         uygulamasi listelenir. Bir launcher icin tam liste sart. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="U30P"
        android:hardwareAccelerated="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Faz 2: HOME olarak secilebilir. Varsayilani degistirmez;
                 bunun icin `cmd package set-home-activity` gerekir. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".CfgReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.kaandikec.u30plauncher.CFG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
